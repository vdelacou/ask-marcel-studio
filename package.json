{
  "name": "ask-marcel-studio",
  "version": "0.1.0",
  "description": "A radically simplified desktop AI studio: models, skills, and one agent-only conversation panel with Microsoft 365 always in reach.",
  "author": "atelier <atelier@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --x64",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "lint": "eslint --cache --max-warnings=0",
    "lint:strict": "LINT_STRICT=1 eslint --max-warnings=0",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "coverage": "bun run scripts/check-coverage.ts",
    "mutate": "stryker run",
    "mutate:changed": "bash scripts/mutate-changed.sh",
    "mutate:staged": "bash scripts/mutate-staged.sh",
    "fetch:python": "bun run scripts/fetch-python.ts",
    "fetch:wheels": "bun run scripts/fetch-wheels.ts",
    "icons": "bash scripts/make-icons.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@electron-toolkit/utils": "^4.0.0",
    "@milkdown/crepe": "^7.22.2",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "ai": "^7.0.127",
    "ask-marcel-office-cli": "^2.8.0",
    "npm": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  }
}
