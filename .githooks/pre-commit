#!/usr/bin/env bash
#
# atelier pre-commit hook — 9 gates
#
# Order matters: cheap fast-fail gates first, expensive gates last so a slow
# mutation run is only paid when everything else is clean.
#
#   1. identity          — no person/employer/client names in the staged tree (rule 26)
#   2. commit size       — ≤10 files AND ≤300 lines (insertions + deletions)
#   3. package.json      — no "latest" / "*" version strings
#   4. secret scan       — gitleaks protect --staged (degrades gracefully)
#   5. tests             — bun test
#   6. strict lint       — bun run lint:strict (0 errors AND 0 warnings)
#   7. typecheck         — the STAGED tree, not the working one (see the script's header)
#   8. coverage          — bun run coverage (per-tier gates)
#   9. mutation testing  — bun run mutate:staged (≥90% on staged domain/use-case files)
#
# Install once per clone:
#
#   git config core.hooksPath .githooks
#
# Bypass with `git commit --no-verify` is reserved for genuine big-bang
# changes (initial scaffolds, mass-renames, generated-file updates). Justify
# every bypass in the commit body. Do not normalise bypassing.

set -euo pipefail

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: 'bun' is not on PATH. Install Bun from https://bun.sh" >&2
  exit 1
fi

echo "pre-commit: running 9 gates..."

echo "[1/9] identity (rule 26)"
bash scripts/check-identity.sh

echo "[2/9] commit size"
bash scripts/check-commit-size.sh

echo "[3/9] package.json (no latest / *)"
bash scripts/check-package-json.sh

echo "[4/9] gitleaks protect --staged"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --verbose --no-banner
else
  echo "  warning: 'gitleaks' not on PATH — skipping secret scan." >&2
  echo "  install: brew install gitleaks (or https://github.com/gitleaks/gitleaks/releases)" >&2
fi

echo "[5/9] bun test"
bun test

echo "[6/9] bun run lint:strict"
bun run lint:strict

echo "[7/9] typecheck (staged tree)"
bash scripts/check-staged-typecheck.sh

echo "[8/9] bun run coverage"
bun run coverage

echo "[9/9] bun run mutate:staged"
bun run mutate:staged

echo "pre-commit: all gates passed"
